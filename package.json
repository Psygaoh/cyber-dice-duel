{
  "name": "cyber-dice-duel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-worker.mjs",
    "test": "node --import tsx --test src/game/__tests__/*.test.ts src/server/__tests__/*.test.ts",
    "test:rules": "node --import tsx --test src/game/__tests__/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "start": "wrangler dev --local"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.180.0",
    "qrcode": "1.5.4",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.180.0",
    "@types/qrcode": "1.5.5",
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "tsx": "4.20.6",
    "esbuild": "0.28.2",
    "drizzle-kit": "0.31.10",
    "wrangler": "4.92.0"
  }
}
